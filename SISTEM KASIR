class Produk:
    pajak_ppn = 0.12  # Class attribute

    def __init__(self, kode, nama, harga, stok):
        # Encapsulation (private attributes)
        self.__kode = kode
        self.__nama = nama
        self.__harga = harga
        self.__stok = stok

    # --- Property & Setter ---
    @property
    def kode(self):
        return self.__kode

    @property
    def nama(self):
        return self.__nama

    @property
    def harga(self):
        return self.__harga

    @harga.setter
    def harga(self, nilai_baru):
        if nilai_baru > 0:
            self.__harga = nilai_baru
        else:
            print("Gagal: Harga harus lebih dari 0!")

    @property
    def stok(self):
        return self.__stok

    @stok.setter
    def stok(self, jumlah_baru):
        if jumlah_baru >= 0:
            self.__stok = jumlah_baru
        else:
            print("Gagal: Stok tidak boleh negatif!")

    # --- Instance Method ---
    def kurangi_stok(self, jumlah):
        if jumlah <= self.__stok:
            self.__stok -= jumlah
            return True
        return False

    def info_produk(self):
        return f"[{self.__kode}] {self.__nama:<20} | {Transaksi.format_rupiah(self.__harga):<12} | Stok: {self.__stok}"

    # --- Class Method ---
    @classmethod
    def ubah_pajak(cls, pajak_baru):
        cls.pajak_ppn = pajak_baru
        print(f"Info: Tarif PPN diubah menjadi {int(pajak_baru * 100)}%")


class Transaksi:
    def __init__(self, nama_kasir):
        self.__nama_kasir = nama_kasir
        self.__keranjang = []

    def tambah_belanjaan(self, produk, jumlah):
        if jumlah <= 0:
            print("Jumlah beli minimal 1.")
            return
        if produk.kurangi_stok(jumlah):
            self.__keranjang.append((produk, jumlah))
            print(f"Berhasil menambahkan {jumlah}x {produk.nama}.")
        else:
            print(f"Stok {produk.nama} tidak cukup (Sisa: {produk.stok}).")

    def cetak_struk(self):
        if not self.__keranjang:
            print("\nKeranjang masih kosong, belum ada transaksi.")
            return

        print("\n" + "=" * 45)
        print("              STRUK PEMBAYARAN")
        print(f"Kasir : {self.__nama_kasir}")
        print("=" * 45)

        subtotal = 0
        for produk, jumlah in self.__keranjang:
            total_item = produk.harga * jumlah
            subtotal += total_item
            print(f"{produk.nama:<20} x{jumlah:<3} {self.format_rupiah(total_item):>16}")

        nilai_pajak = subtotal * Produk.pajak_ppn
        total_bayar = subtotal + nilai_pajak

        print("-" * 45)
        print(f"{'Subtotal':<24} : {self.format_rupiah(subtotal):>16}")
        print(f"{'PPN (' + str(int(Produk.pajak_ppn * 100)) + '%)':<24} : {self.format_rupiah(nilai_pajak):>16}")
        print(f"{'TOTAL BAYAR':<24} : {self.format_rupiah(total_bayar):>16}")
        print("=" * 45 + "\n")

    # --- Static Method ---
    @staticmethod
    def format_rupiah(nominal):
        return f"Rp {nominal:,.0f}".replace(",", ".")


